<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp1.ViewModels"
        Title="Option Dashboard"
        Width="1600" Height="900"
        Background="#000">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- ====================== CE PANEL ====================== -->
            <TextBlock Text="CE SYMBOLS"
                       Foreground="Orange"
                       FontSize="18"
                       Margin="10"/>

            <ItemsControl ItemsSource="{Binding CEOnly}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Data.Symbol}"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <ContentPresenter Content="{Binding Chart}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <!-- ==================== GAP BETWEEN CE AND PE ==================== -->
            <Border Height="50"/>
            <!-- adjust to 100 or 200 as needed -->


            <!-- ====================== PE PANEL ====================== -->
            <TextBlock Text="PE SYMBOLS"
                       Foreground="SkyBlue"
                       FontSize="18"
                       Margin="10"/>

            <ItemsControl ItemsSource="{Binding PEOnly}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Data.Symbol}"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <ContentPresenter Content="{Binding Chart}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

</Window>
