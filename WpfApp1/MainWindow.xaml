<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp1.ViewModels"
        Title="CE / PE Side-by-Side"
        Width="1800" Height="1000"
        Background="#000">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CE LEFT -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="CALL OPTIONS (CE)"
                           Foreground="Orange"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           Margin="10"/>

                <ItemsControl ItemsSource="{Binding CEOnly}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5" Width="250" Height="80" BorderBrush="#222" BorderThickness="1">
                                <StackPanel>
                                    <!--<TextBlock Text="{Binding Data.Ltp}"
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>-->

                                    <ContentPresenter Content="{Binding Chart}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- PE RIGHT -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="PUT OPTIONS (PE)"
                           Foreground="SkyBlue"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           Margin="10"/>

                <ItemsControl ItemsSource="{Binding PEOnly}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5" Width="250" Height="80" BorderBrush="#222" BorderThickness="1">
                                <StackPanel>
                                    <!--<TextBlock Text="{Binding Data.Symbol}"
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>-->

                                    <ContentPresenter Content="{Binding Chart}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Window>
