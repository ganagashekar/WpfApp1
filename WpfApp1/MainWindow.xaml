<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp1.ViewModels"
        Title="CE / PE Side-by-Side"
        Width="1800" Height="1000"
        Background="#000">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- CE GRID -->
                <ColumnDefinition Width="5" />
                <!-- GAP -->
                <ColumnDefinition Width="*" />
                <!-- PE GRID -->
            </Grid.ColumnDefinitions>

            <!-- ================= CE LEFT ================= -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="CALL OPTIONS (CE)"
                           Foreground="Orange"
                           FontSize="16"
                           Margin="1"
                           HorizontalAlignment="Center"/>

                <ItemsControl ItemsSource="{Binding CEOnly}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- 5 columns -->
                            <WrapPanel Orientation="Horizontal"
                                       ItemWidth="200"   
                                ItemHeight="80"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="250" Height="80" Margin="1">
                                <TextBlock Text="{Binding Data.Symbol}"
                                           Foreground="White"
                                           FontSize="12"
                                           HorizontalAlignment="Center"/>
                                <ContentPresenter Content="{Binding Chart}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>


            <!-- ================ PE RIGHT ================= -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="PUT OPTIONS (PE)"
                           Foreground="SkyBlue"
                           FontSize="16"
                           Margin="1"
                           HorizontalAlignment="Center"/>

                <ItemsControl ItemsSource="{Binding PEOnly}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- 5 columns -->
                            <WrapPanel Orientation="Horizontal"
                                       ItemWidth="200"
                                       ItemHeight="80"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="250" Height="80" Margin="1">
                                <TextBlock Text="{Binding Data.Symbol}"
                                           Foreground="White"
                                           FontSize="12"
                                           HorizontalAlignment="Center"/>
                                <ContentPresenter Content="{Binding Chart}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Window>
